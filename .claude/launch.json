{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "App", "run", "web"],
      "port": 8081
    },
    {
      "name": "django-api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd Backend && .venv/bin/python manage.py runserver 0.0.0.0:8000"
      ],
      "port": 8000
    }
  ]
}
